          <q1:parameter uniqueID="UID_OBJ_20E0" access="readWriteOutput">
            <description lang="en">TMC9660 register THERMAL_WINDING_TIME_CONSTANT_1
Thermal winding time constant for the used motor. Used for IIT monitoring. Setting a new value restarts the IIT monitoring.
Min: 1000; Max: 60000; Default: 3000; Unit: ms
  </description>
            <DINT />
