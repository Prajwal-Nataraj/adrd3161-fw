          <q1:parameter uniqueID="UID_OBJ_20D6" access="readWriteOutput">
            <description lang="en">TMC9660 register BRAKE_CHOPPER_HYSTERESIS
An activated brake chopper will be deactivated if the actual supply voltage is lower than BRAKE_CHOPPER_VOLTAGE_LIMIT - BRAKE_CHOPPER_HYSTERESIS.
Min: 0; Max: 50; Default: 5; Unit: 0.1V
  </description>
            <DINT />
