Periodically summed up actual torque value. This is only used for simplified measurement with low measurement frequency during tuning operations.
Min: 0; Max: 4294967295; Default: 0
  </description>
            <UDINT />
            <q1:defaultValue value="0" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="APP_SHADOW" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_214E">
            <description lang="en">TMC9660 register INTEGRATED_ACTUAL_VELOCITY_VALUE
Periodically summed up actual velocity value. This is only used for simplified measurement with low measurement frequency during tuning operations.
Min: 0; Max: 4294967295; Default: 0
  </description>
            <UDINT />
            <q1:defaultValue value="0" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="APP_SHADOW" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6040" access="readWrite">
            <description lang="en">Controls the CiA 402-1 state machine
* bit 15-11: manufacturer specific
* bit 10-9: reserved, set to zero
* bit 8: halt
* bit 7: Fault reset
* bit 6-4: Operation mode specific
  * Profile velocity mode: unused
* bit 3: Enable operation
* bit 2: Quick stop
* bit 1: Enable voltage
* bit 0: Switch on</description>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6041">
            <description lang="en">Indicates the state of the CiA 402-1 state machine
* bit 0: Ready to switch on
* bit 1: Switched on
* bit 2: Operation enabled
* bit 3: Fault
* bit 4: Voltage enabled
* bit 5: Quick stop
* bit 6: Switch on disabled
* bit 7: Warning
* bit 8: Manufacturer specific
* bit 9: Remote
* bit 10: Target reached
* bit 11: Internal limit active
* bit 12-13: Operation mode specific
* bit 15-14: Manufacturer specific
</description>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6060" access="readWrite">
            <description lang="en">* -1 ... -128: manufacturer specific modes of operation
* 0: reserved
* 1: Profile Position Mode
* 2: Velocity Mode
* 3: Profile Velocity Mode
* 4: Torque Profile Mode
* 5: reserved
* 6: Homing Mode
* 7: Interpolated Position Mode
* 8 ... 127: reserved</description>
            <SINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6061">
            <description lang="en">Current mode of operation. May differ from the value written to 0x6060 Modes of operation. Same data description as 0x6060.</description>
            <SINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6064">
            <label lang="en">Position actual value</label>
            <DINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_606B">
            <description lang="en">Trajectory generator value. TMC9660 RAMP_VELOCITY</description>
            <DINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_606C">
            <description lang="en">TMC9660 ACTUAL_VELOCITY</description>
            <DINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6071" access="readWrite">
            <label lang="en">Target torque</label>
            <INT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6072">
            <label lang="en">Max torque</label>
            <UINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6077">
            <label lang="en">Torque actual value</label>
            <INT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_607A" access="readWrite">
            <label lang="en">Target position</label>
            <DINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_607E" access="readWrite">
            <label lang="en">Polarity</label>
            <USINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6081" access="readWrite">
            <description lang="en">TMC9660 vmax / target vel</description>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6083" access="readWrite">
            <description lang="en">TMC9660 target acceleration</description>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6084" access="readWrite">
            <description lang="en">TMC9660 target deceleration</description>
            <UDINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6086" access="readWrite">
            <description lang="en">* 0 = linear ramp / trapezoidal profile</description>
            <INT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_60FF" access="readWrite">
            <label lang="en">Target velocity</label>
            <DINT />
            <q1:defaultValue value="0" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_6502" access="readWrite">
            <description lang="en">* bit 0: profile position
* bit 1: velocity
* bit 2: profile velocity &lt;&lt;&lt;&lt;&lt; we have this
* bit 3: torque
* bit 4: reserved
* bit 5: homing
* bit 6: interpolated position
* bit 7: cyclic synchronous position
* bit 8: cyclic synchronous velocity
* bit 9: cyclic synchronous torque
* bit 10: cyclic synchromous torque with commutation angle
* bits 11-15: reserved
* bit 16-31: manufacturer specific</description>
            <UDINT />
            <q1:defaultValue value="0x0000038D" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_67FF">
            <description lang="en">CiA 402-1</description>
            <UDINT />
            <q1:defaultValue value="0x00020192" />
          </q1:parameter>
        </q1:parameterList>
      </q1:ApplicationProcess>
    </ProfileBody>
  </ISO15745Profile>
