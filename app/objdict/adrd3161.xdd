          <q1:parameter uniqueID="UID_OBJ_2000" access="readWriteOutput">
            <description lang="en">TMC9660 register MOTOR_TYPE
Selected motor type. PWM must be turned off to change this.
Min: 0; Max: 3; Default: 0
Values:
  NO_MOTOR = 0
  DC_MOTOR = 1
  STEPPER_MOTOR = 2
  BLDC_MOTOR = 3
  </description>
            <DINT />
            <q1:defaultValue value="0" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="PERSIST_TMC" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2001" access="readWriteOutput">
            <description lang="en">TMC9660 register MOTOR_POLE_PAIRS
Pole pair count of the motor.
Min: 0; Max: 127; Default: 1
  </description>
            <DINT />
            <q1:defaultValue value="1" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="PERSIST_TMC" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2002" access="readWriteOutput">
            <description lang="en">TMC9660 register MOTOR_DIRECTION
Motor direction bit. Inverts the motor direction.
Min: 0; Max: 1; Default: 0
Values:
  NOT_INVERTED = 0
  INVERTED = 1
  </description>
            <DINT />
            <q1:defaultValue value="0" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="PERSIST_TMC" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2003" access="readWriteOutput">
            <description lang="en">TMC9660 register MOTOR_PWM_FREQUENCY
Set the frequency of the motor PWM.
Min: 10000; Max: 100000; Default: 25000; Unit: Hz
  </description>
            <DINT />
            <q1:defaultValue value="25000" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="PERSIST_TMC" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2004" access="readWriteOutput">
            <description lang="en">TMC9660 register COMMUTATION_MODE
Selected FOC operation mode depending on feedback used for commutation.
Min: 0; Max: 8; Default: 0
Values:
  SYSTEM_OFF = 0
  SYSTEM_OFF_LOW_SIDE_FETS_ON = 1
  SYSTEM_OFF_HIGH_SIDE_FETS_ON = 2
  FOC_OPENLOOP_VOLTAGE_MODE = 3
  FOC_OPENLOOP_CURRENT_MODE = 4
  FOC_ABN = 5
  FOC_HALL_SENSOR = 6
  RESERVED = 7
  FOC_SPI_ENC = 8
  </description>
            <DINT />
            <q1:defaultValue value="0" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="APP_SHADOW" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2005" access="readWriteOutput">
            <description lang="en">TMC9660 register OUTPUT_VOLTAGE_LIMIT
PID UQ/UD output limit for circular limiter.
Min: 0; Max: 32767; Default: 8000
  </description>
            <DINT />
            <q1:defaultValue value="8000" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="PERSIST_TMC" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2006" access="readWriteOutput">
            <description lang="en">TMC9660 register MAX_TORQUE
Maximum motor torque. *This value can be temporarily exceeded marginally due to the operation of the current regulator.
Min: 0; Max: 65535; Default: 2000; Unit: mA
  </description>
            <DINT />
            <q1:defaultValue value="2000" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="PERSIST_TMC" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2007" access="readWriteOutput">
            <description lang="en">TMC9660 register MAX_FLUX
Max. motor flux. *This value can be temporarily exceeded marginally due to the operation of the current regulator.
Min: 0; Max: 65535; Default: 2000; Unit: mA
  </description>
            <DINT />
            <q1:defaultValue value="2000" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="PERSIST_TMC" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2008" access="readWriteOutput">
