Break before make time for the high side gate of the Y2 phase. Applied before switching from low to high.
Min: 0; Max: 255; Default: 0; Unit: 8.33ns
  </description>
            <DINT />
            <q1:defaultValue value="0" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="PERSIST_TMC" />
