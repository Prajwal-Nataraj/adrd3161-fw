  </description>
            <DINT />
            <q1:defaultValue value="0" />
            <q1:property name="CO_countLabel" value="TMC_PARAMS" />
            <q1:property name="CO_storageGroup" value="APP_SHADOW" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_205A" access="readWriteOutput">
            <description lang="en">TMC9660 register ABN_1_STEPS
ABN 1 encoder steps per rotation (CPR).
Min: 0; Max: 16777215; Default: 65536
  </description>
