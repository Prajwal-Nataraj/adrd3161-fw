&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <0x1>;
        #size-cells = <0x1>;

        program_partition: partition@0 {
            label = "program";
            reg = <0 0x3c000>;
        };

        storage_partition: partition@3c000 {
            label = "storage";
            reg = <0x3c000 0x4000>;
        };

        /* Inform linker: */
        memory@10000000 {
            compatible = "zephyr,memory-region";
            reg = <0x10000000 0x3c000>;
            zephyr,memory-region = "FLASH";
        };

        memory@1003c000 {
            compatible = "zephyr,memory-region";
            reg = <0x1003c000 0x4000>;
            zephyr,memory-region = "STORAGE";
        };
    };
};
